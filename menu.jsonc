{
  // RavenSpot menu definition — KDE Plasma 6 / CachyOS Spotlight Launcher.
  // Ek alan: "iconName" — candy-icons (freedesktop) ikon temasından renkli ikon.
  //   iconName varsa QML renkli tema ikonunu gösterir; yoksa icon (Nerd Font glifi) kullanılır.

  // ─── Kök menü ────────────────────────────────────────────────
  "apps": { "icon": "󰀻", "iconName": "applications-all", "label": "Apps", "aliases": ["app", "applications", "uygulamalar"] },
  "shell": { "icon": "", "iconName": "utilities-terminal", "label": "Shell", "aliases": ["terminal", "konsole", "bash", "fish", "shell"], "action": "konsole" },
  "downloads": { "icon": "󰇚", "iconName": "aptdaemon-download", "label": "Downloads", "aliases": ["downloads", "indirilenler", "download", "dosyalar", "files"], "provider": "files-downloads" },
  "browser": { "icon": "󰖟", "iconName": "web-browser", "label": "Browser", "action": "xdg-open https://www.mozilla.org/" },
  "discover": { "icon": "󰀻", "iconName": "plasmadiscover", "label": "Discover", "aliases": ["discover", "store", "mağaza", "yazılım", "market"], "action": "plasma-discover" },
  "cachyupdate": { "icon": "󰚰", "iconName": "cachy-update-blue", "label": "Cachy Update", "aliases": ["cachy", "update", "güncelle", "cachyos", "pacman"], "action": "konsole -e arch-update" },
  "appearance": { "icon": "󰏘", "iconName": "cs-themes", "label": "Appearance", "aliases": ["style", "theme"] },
  "trigger": { "icon": "󱓞", "iconName": "gnome-screenshot", "label": "Trigger" },
  "settings": { "icon": "", "iconName": "gnome-settings", "label": "Settings", "aliases": ["settings", "ayarlar", "setup", "config", "control", "yapılandırma", "sistem ayarları"], "action": "systemsettings" },
  "system": { "icon": "", "iconName": "system-shutdown", "label": "System", "aliases": ["power-menu", "power"] },
  "help": { "icon": "", "iconName": "help-browser", "label": "Help", "aliases": ["help", "yardım", "kılavuz", "info"] },

  // ─── Apps Kategorileri ─────────────────────────────────────────
  "apps.games": { "icon": "󰊴", "iconName": "applications-games", "label": "Games", "aliases": ["games", "oyunlar"], "provider": "apps-games" },
  "apps.internet": { "icon": "󰖟", "iconName": "applications-internet", "label": "Internet", "aliases": ["internet", "web", "tarayıcı"], "provider": "apps-internet" },
  "apps.development": { "icon": "󰅩", "iconName": "applications-development", "label": "Development", "aliases": ["dev", "geliştirme", "kod"], "provider": "apps-development" },
  "apps.multimedia": { "icon": "󰕼", "iconName": "applications-multimedia", "label": "Multimedia", "aliases": ["media", "müzik", "video", "ses"], "provider": "apps-multimedia" },
  "apps.graphics": { "icon": "󰏘", "iconName": "applications-graphics", "label": "Graphics", "aliases": ["grafik", "resim", "tasarım"], "provider": "apps-graphics" },
  "apps.office": { "icon": "󰏆", "iconName": "applications-office", "label": "Office", "aliases": ["ofis", "belge", "pdf"], "provider": "apps-office" },
  "apps.system": { "icon": "󰒓", "iconName": "applications-system", "label": "System", "aliases": ["sistem", "yönetim"], "provider": "apps-system" },
  "apps.utilities": { "icon": "󰘦", "iconName": "applications-utilities", "label": "Utilities", "aliases": ["araçlar", "faydalı"], "provider": "apps-utilities" },
  "apps.all": { "icon": "󰀻", "iconName": "applications-all", "label": "All Apps", "aliases": ["all", "tümü", "hepsi"], "provider": "apps-all" },

  // ─── System (Güç & Oturum Eylemleri) ─────────────────────────
  "system.reboot": { "icon": "󰜉", "iconName": "system-reboot", "label": "Reboot", "description": "Restart the system", "aliases": ["reboot", "restart", "yeniden başlat"], "action": "qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logoutAndReboot" },
  "system.shutdown": { "icon": "󰐥", "iconName": "system-shutdown", "label": "Shutdown", "description": "Power off the computer", "aliases": ["shutdown", "poweroff", "kapat"], "action": "qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logoutAndShutdown" },
  "system.lock": { "icon": "", "iconName": "system-lock-screen", "label": "Lock", "description": "Lock current session", "aliases": ["lock", "kilitle"], "action": "loginctl lock-session" },
  "system.logout": { "icon": "󰍃", "iconName": "system-log-out", "label": "Logout", "description": "Log out of session", "aliases": ["logout", "çıkış"], "action": "qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout" },
  "system.suspend": { "icon": "󰒲", "iconName": "system-suspend", "label": "Suspend", "description": "Suspend system to RAM", "aliases": ["suspend", "sleep", "uyku"], "action": "systemctl suspend" },
  "system.hibernate": { "icon": "󰤁", "iconName": "system-hibernate", "label": "Hibernate", "description": "Save state to disk and shut down", "when": "[[ -f /sys/power/state ]] && grep -qw disk /sys/power/state", "aliases": ["hibernate"], "action": "systemctl hibernate" },
  "system.screensaver": { "icon": "󱄄", "iconName": "screensaver", "label": "Screensaver", "description": "Turn on screensaver", "aliases": ["screensaver", "ekran koruyucu"], "action": "loginctl lock-session" },

  // ─── Appearance ──────────────────────────────────────────────
  "appearance.ravenspot_theme": { "icon": "󰔉", "iconName": "cs-themes", "label": "RavenSpot Temaları (5 Özel Stil)", "aliases": ["ravenspot theme", "tema", "theme", "style", "görünüm"], "provider": "ravenspot-themes" },
  "appearance.colorscheme": { "icon": "󰸌", "iconName": "cs-color", "label": "KDE Renk Şeması (Color Scheme)", "aliases": ["colors", "theme"], "provider": "colorschemes" },
  "appearance.wallpaper": { "icon": "", "iconName": "gnome-settings-background", "label": "Wallpaper", "action": "systemsettings kcm_wallpaper" },
  "appearance.nightlight": { "icon": "󰔎", "iconName": "redshift-status-on", "label": "Night Light", "action": "systemsettings kcm_nightlight" },
  "appearance.cursor": { "icon": "󰇀", "iconName": "preferences-desktop-mouse", "label": "Cursor Theme", "action": "systemsettings kcm_cursortheme" },
  "appearance.icons": { "icon": "󰀻", "iconName": "icons", "label": "Icon Theme", "action": "systemsettings kcm_icons" },
  "appearance.fonts": { "icon": "", "iconName": "gnome-settings-font", "label": "Fonts", "action": "systemsettings kcm_fonts" },
  "appearance.powerprofile": { "icon": "󰂖", "iconName": "battery", "label": "Power Profile", "provider": "power-profiles" },

  // ─── Trigger ─────────────────────────────────────────────────
  "trigger.capture": { "icon": "", "iconName": "gnome-screenshot", "label": "Capture", "aliases": ["screenshot", "screenrecord"] },
  "trigger.capture.fullscreen": { "icon": "󰍹", "iconName": "gnome-screenshot", "label": "Fullscreen", "action": "spectacle -f -b -n" },
  "trigger.capture.activewindow": { "icon": "󰖲", "iconName": "gnome-screenshot", "label": "Active Window", "action": "spectacle -a -b -n" },
  "trigger.capture.region": { "icon": "󰆞", "iconName": "gnome-screenshot", "label": "Region", "action": "spectacle -r -b -n" },
  "trigger.capture.screenrecord": { "icon": "", "iconName": "gnome-screenshot", "label": "Screen Recording", "action": "spectacle -R" },
  "trigger.emoji": { "icon": "", "label": "Emoji", "aliases": ["emoji", "emojis"], "action": "plasma-emojier" },
  "trigger.clipboard": { "icon": "󰅇", "iconName": "org.kde.plasma.clipboard", "label": "Clipboard History", "aliases": ["clipboard", "pano", "kopyalananlar"], "provider": "clipboard" },

  // ─── Trigger -> Nashi Radial Hub ──────────────────────────────
  "trigger.nashi": { "icon": "󰴹", "iconName": "nashi", "label": "Nashi", "aliases": ["nashi", "çark", "wheel", "converter", "radial"] },
  "trigger.nashi.convert": { "icon": "󰑮", "iconName": "system-reboot", "label": "Dönüştürme Çarkı (Convert Wheel)", "aliases": ["convert", "dönüştür", "çark", "format"], "action": "/home/dokuro/Masaüstü/orkunprogram/nashi-linux/nashi --convert" },
  "trigger.nashi.tools": { "icon": "󰘦", "iconName": "applications-utilities", "label": "Araçlar Çarkı (Tools Wheel)", "aliases": ["tools", "araçlar", "qr", "pdf"], "action": "/home/dokuro/Masaüstü/orkunprogram/nashi-linux/nashi --tools" },
  "trigger.nashi.actions": { "icon": "󰌨", "iconName": "input-keyboard", "label": "Eylemler Çarkı (Actions Wheel)", "aliases": ["actions", "eylemler", "kısayol"], "action": "/home/dokuro/Masaüstü/orkunprogram/nashi-linux/nashi --actions" },
  "trigger.nashi.window": { "icon": "󰴹", "iconName": "nashi", "label": "Nashi Ana Pencere (File Garden)", "aliases": ["nashi", "window", "pencere", "garden"], "action": "/home/dokuro/Masaüstü/orkunprogram/nashi-linux/nashi" },

  // ─── Settings (KDE System Settings & KCMs) ───────────────────
  "settings.shortcuts": { "icon": "󰌌", "iconName": "preferences-desktop-keyboard", "label": "Shortcuts (Klavye Kısayolları)", "aliases": ["shortcuts", "kısayollar", "klavye kısayolları", "hotkeys", "keybindings", "keys"], "action": "systemsettings kcm_keys" },
  "settings.general": { "icon": "", "iconName": "preferences-system", "label": "System Settings (Tüm Ayarlar)", "aliases": ["general", "settings", "ayarlar", "system settings", "denetim masası"], "action": "systemsettings" },
  "settings.monitors": { "icon": "󰍹", "iconName": "cs-display", "label": "Monitors & Display (Ekran)", "aliases": ["display", "monitors", "ekran", "çözünürlük", "screen", "hz", "yenileme hızı"], "action": "systemsettings kcm_kscreen" },
  "settings.audio": { "icon": "󰕾", "iconName": "audio-volume-high", "label": "Audio & Sound (Ses Ayarları)", "aliases": ["sound", "audio", "ses", "mikrofon", "hoparlör", "volume"], "action": "systemsettings kcm_pulseaudio" },
  "settings.power": { "icon": "󰂄", "iconName": "preferences-system-power-management", "label": "Power Management (Güç & Pil)", "aliases": ["power", "battery", "pil", "enerji", "güç", "sleep timer", "uyku"], "action": "systemsettings kcm_powerdevilprofilesconfig" },
  "settings.network": { "icon": "󰛳", "iconName": "cs-network", "label": "Network & Wi-Fi (Ağ)", "aliases": ["network", "wifi", "ağ", "internet", "ethernet", "ip"], "action": "systemsettings kcm_networkmanagement" },
  "settings.bluetooth": { "icon": "󰂯", "iconName": "bluetooth", "label": "Bluetooth", "aliases": ["bluetooth", "bt", "kablosuz aygıtlar"], "action": "systemsettings kcm_bluetooth" },
  "settings.keyboard": { "icon": "", "iconName": "cs-keyboard", "label": "Keyboard (Klavye Düzeni)", "aliases": ["keyboard", "klavye", "dil", "layout", "f klavye", "q klavye"], "action": "systemsettings kcm_keyboard" },
  "settings.mouse": { "icon": "󰍽", "iconName": "preferences-desktop-mouse", "label": "Mouse (Fare & İmleç)", "aliases": ["mouse", "fare", "hız", "pointer", "imleç"], "action": "systemsettings kcm_mouse" },
  "settings.touchpad": { "icon": "󰟖", "iconName": "preferences-desktop-touchpad", "label": "Touchpad (Dokunmatik Yüzey)", "aliases": ["touchpad", "dokunmatik yüzey", "trackpad", "tıklama"], "action": "systemsettings kcm_touchpad" },
  "settings.autostart": { "icon": "󰐥", "iconName": "system-run", "label": "Autostart (Otomatik Başlatma)", "aliases": ["autostart", "başlangıç", "açılışta çalışanlar", "startup"], "action": "systemsettings kcm_autostart" },
  "settings.users": { "icon": "󰏘", "iconName": "user-identity", "label": "Users (Kullanıcı Hesapları)", "aliases": ["users", "kullanıcı", "hesap", "accounts", "şifre"], "action": "systemsettings kcm_users" },
  "settings.screenlocker": { "icon": "󰌾", "iconName": "system-lock-screen", "label": "Screen Lock (Ekran Kilidi)", "aliases": ["screen lock", "ekran kilidi", "güvenlik", "kilit"], "action": "systemsettings kcm_screenlocker" },
  "settings.notifications": { "icon": "󰂛", "iconName": "gnome-panel-notification-area", "label": "Notifications (Bildirimler)", "aliases": ["notifications", "bildirimler", "uyarılar", "rahatsız etme"], "action": "systemsettings kcm_notifications" },
  "settings.desktop": { "icon": "󰪶", "iconName": "gnome-settings-background", "label": "Wallpaper (Masaüstü & Duvar Kâğıdı)", "aliases": ["wallpaper", "duvar kağıdı", "arka plan", "background", "desktop"], "action": "systemsettings kcm_wallpaper" },
  "settings.nightlight": { "icon": "󰔎", "iconName": "redshift-status-on", "label": "Night Light (Gece Işığı)", "aliases": ["night light", "gece ışığı", "mavi ışık"], "action": "systemsettings kcm_nightlight" },
  "settings.colors": { "icon": "󰸌", "iconName": "cs-color", "label": "Colors (Renk Şemaları)", "aliases": ["colors", "renkler", "tema", "koyu mod", "dark mode"], "action": "systemsettings kcm_colors" },
  "settings.fonts": { "icon": "󰬴", "iconName": "preferences-desktop-font", "label": "Fonts (Yazı Tipleri)", "aliases": ["fonts", "yazı tipi", "font", "karakter boyutu"], "action": "systemsettings kcm_fonts" },
  "settings.defaultapps": { "icon": "󰀻", "iconName": "preferences-desktop-default-applications", "label": "Default Apps (Varsayılan Uygulamalar)", "aliases": ["default apps", "varsayılan uygulamalar", "öntanımlı"], "action": "systemsettings kcm_componentchooser" },
  "settings.about": { "icon": "", "iconName": "help-about", "label": "About (Sistem Hakkında)", "aliases": ["about", "hakkında", "sistem bilgisi", "cachyos", "donanım"], "action": "systemsettings kcm_about-distro" },
  "settings.firewall": { "icon": "󰒃", "iconName": "security-high", "label": "Firewall (Güvenlik Duvarı)", "aliases": ["firewall", "güvenlik duvarı", "ufw"], "action": "systemsettings kcm_firewall" },
  "settings.activities": { "icon": "󰏘", "iconName": "org.kde.plasma.showActivityManager", "label": "Activities (Etkinlikler)", "aliases": ["activities", "etkinlikler"], "action": "systemsettings kcm_activities" },

  // ─── Help & Shortcuts ─────────────────────────────────────────
  "help.shortcuts": { "icon": "󰌌", "iconName": "preferences-desktop-keyboard", "label": "Klavye Kısayolları (Hile Sayfası)", "action": "notify-send -t 6000 'RavenSpot Kısayolları' '• Meta+Space: Menüyü Aç\n• Esc / Backspace: Geri / Kapat\n• >: Terminal Komutu\n• =: Hesap Makinesi\n• ?: Web Arama\n• F: Temayı Favorile' -i preferences-desktop-keyboard" },
  "help.ravenspot": { "icon": "󰘦", "iconName": "help-about", "label": "RavenSpot Kullanım Kılavuzu", "action": "xdg-open /home/dokuro/Masaüstü/ravenspot/README.md" },
  "help.nashi": { "icon": "󰴹", "iconName": "nashi", "label": "Nashi Çark Dokümantasyonu", "action": "xdg-open /home/dokuro/Masaüstü/orkunprogram/nashi-linux/DESIGN.md" },
  "help.cachyos": { "icon": "󰣇", "iconName": "cachy-update-blue", "label": "CachyOS Wiki ve Yardım", "action": "xdg-open https://wiki.cachyos.org" },
  "help.sysinfo": { "icon": "󰍹", "iconName": "help-about", "label": "Sistem Özeti", "action": "systemsettings kcm_about-distro" }
}
